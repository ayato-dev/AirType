{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Airtype",
  "version": "0.1.0",
  "identifier": "dev.ayato.airtype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Airtype",
        "url": "index.html",
        "width": 460,
        "height": 700,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["popover", "acrylic"],
          "state": "active",
          "radius": 18
        }
      },
      {
        "label": "hud",
        "title": "Airtype HUD",
        "url": "hud.html",
        "width": 380,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI translator and editor for any text field",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
